# ============================================================
# LLM PROVIDER CONFIGURATION
# ============================================================
# Choose "gemini" or "ollama"
LLM_PROVIDER=ollama

# --- Gemini (required only if LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Ollama (required only if LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=llama3.2:latest

# ============================================================
# WORKFLOW ENGINE
# ============================================================
STEP_TIMEOUT_SECONDS=60
STEP_MAX_RETRIES=1

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite:///./enterprise_workflow.db

# ============================================================
# API SECURITY
# ============================================================
# Leave blank to run the API without auth (local/demo use only).
# Set a strong random value to require `Authorization: Bearer <token>`
# on all write endpoints.
API_AUTH_TOKEN=

# ============================================================
# REPORTS
# ============================================================
REPORTS_OUTPUT_DIR=reports_output
